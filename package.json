{
  "name": "session-copy",
  "version": "2.3.1",
  "description": "Copy and restore encrypted login sessions for any website",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs dist release",
    "build": "node scripts/build.mjs",
    "build:release": "cross-env RELEASE=1 node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prebuild": "node scripts/clean.mjs dist",
    "package": "node scripts/package.mjs",
    "prepackage": "npm run build:release",
    "release": "npm run package",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@makogai/extension-brand": "file:../chrome-extensions/packages/brand",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@vue/tsconfig": "^0.7.0",
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "fs-extra": "^11.3.0",
    "typescript": "^5.8.3",
    "unplugin-vue": "^7.2.0",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=20"
  }
}
