{
  "name": "Session Copy",
  "description": "Copy and restore encrypted login sessions for any website. Offline, private, and built for secure transfer between browsers.",
  "version": "0.0.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Session Copy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "64": "assets/icons/icon64.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "64": "assets/icons/icon64.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "js": ["content/before.js"],
      "matches": ["https://*/*", "http://*/*"]
    },
    {
      "run_at": "document_idle",
      "js": ["content/after.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "permissions": [
    "tabs",
    "scripting",
    "cookies",
    "clipboardWrite",
    "clipboardRead",
    "storage"
  ],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
